<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- PUT/PATCH/DELETE için WebDAV'ı kapat (yoksa remove zararsız) -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <security>
      <requestFiltering>
        <!-- ~45 MB belge / hero yükleme -->
        <requestLimits maxAllowedContentLength="47185920" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
